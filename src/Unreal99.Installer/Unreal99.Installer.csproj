<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Unreal99Installer</AssemblyName>
    <RootNamespace>Unreal99.Setup</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>CA1416</NoWarn>
    <ApplicationIcon>..\Unreal99\Assets\Unreal99.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Unreal99\Core\MathX.cs" Link="Shared\MathX.cs" />
    <Compile Include="..\Unreal99\Platform\AppIcon.cs" Link="Shared\AppIcon.cs" />
    <Compile Include="..\Unreal99\Platform\Screenshot.cs" Link="Shared\Screenshot.cs" />
    <Compile Include="..\Unreal99\Platform\Shortcut.cs" Link="Shared\Shortcut.cs" />
    <Content Include="..\Unreal99\Assets\Unreal99Logo.png" Link="Assets\Unreal99Logo.png"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
